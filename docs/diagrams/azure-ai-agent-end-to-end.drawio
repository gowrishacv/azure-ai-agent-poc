        <mxCell id="note1" value="&lt;b&gt;Private-profile constraint&lt;/b&gt;&lt;br&gt;Microsoft-hosted Azure DevOps agents cannot reach private endpoints. Run document indexing from a VNet-connected self-hosted agent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D6A100;fontFamily=Segoe UI;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="p1"><mxGeometry x="45" y="990" width="820" height="90" as="geometry"/></mxCell>
        <mxCell id="note2" value="&lt;b&gt;Do not create an Internet NSG rule for TCP 8000&lt;/b&gt;&lt;br&gt;Port 8000 is the internal container target. Public clients use HTTPS 443 on the Container Apps FQDN." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F1;strokeColor=#C63B3B;fontFamily=Segoe UI;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="p1"><mxGeometry x="935" y="990" width="820" height="90" as="geometry"/></mxCell>
        <mxCell id="note3" value="The implemented private profile keeps Container Apps ingress, ACR, and monitoring endpoints public. Front Door/WAF, APIM, private ACR, internal ingress, inspected egress, and private monitoring are explicit enterprise extensions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFA;strokeColor=#7B61A8;fontFamily=Segoe UI;fontSize=12;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="p1"><mxGeometry x="45" y="1100" width="1710" height="70" as="geometry"/></mxCell>
